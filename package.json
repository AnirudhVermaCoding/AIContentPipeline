{
  "name": "aicontentpipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, multi-brand AI short-form video pipeline (brand + topic -> 720x1280 MP4 + cost report)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "remotion:studio": "remotion studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.65",
    "@fal-ai/client": "^1.10.1",
    "@remotion/bundler": "4.0.523",
    "@remotion/cli": "4.0.523",
    "@remotion/renderer": "4.0.523",
    "ai": "^7.0.97",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "mediabunny": "^1.56.1",
    "p-limit": "^7.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.523",
    "sharp": "^0.35.4",
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "better-sqlite3",
      "esbuild",
      "ffmpeg-static",
      "sharp"
    ]
  }
}
