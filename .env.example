# Copy to .env and fill in the keys for the providers you use.
# Every provider is optional; the pipeline reports what is missing for the selected brand config.

# Provider mode: "live" calls real APIs, "mock" produces placeholder assets offline (tests, dry runs)
PROVIDER_MODE=live

# LLM (default: OpenAI GPT-5.6 Terra for creative work, Luna for mechanical work)
OPENAI_API_KEY=

# Image + video generation via fal.ai (FLUX.2 Pro keyframes, MiniMax H3 Max image-to-video)
FAL_KEY=

# Text-to-speech (default Cartesia Sonic 3.5; ElevenLabs optional, selectable per brand)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Stock footage (optional, not used by the MVP-A path)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Where runs, the SQLite database and caches live (defaults shown)
# AICP_RUNS_DIR=./runs
# AICP_DATA_DIR=./data

# Remotion normally downloads its own headless browser. On machines where that is blocked, point it
# at a local chrome-headless-shell (or a full Chrome with REMOTION_CHROME_MODE=chrome-for-testing).
# REMOTION_BROWSER_EXECUTABLE=
# REMOTION_CHROME_MODE=headless-shell

# Studio (pnpm studio): ports and the origin the API accepts mutations from (defaults shown)
# STUDIO_API_PORT=4747
# STUDIO_WEB_PORT=3000
# STUDIO_WEB_ORIGIN=http://localhost:3000
